<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.app.mapper.ClothMapper">

<!--全件取得-->
<!--oreder by カラム名= どういう順番で並び替えるか-->
<select id="findAllDesc" resultType="Cloth">
 select * from item  order by id desc

</select>

<!--データ１件追加（Clothのすべてのフィールドに対応）-->
<!--カラム名もきちんと書くとvaluesの順番ずれても正しくマッチングする-->
<insert id="add" parameterType="Cloth">
 insert into item(
 name,
 category,
 color,
 brand,
 price,
 is_favorite,
 image_name,
 is_spring,
 is_summer,
 is_autumn,
 is_winter
 )
 values(
 #{name},
 #{category},
 #{color},
 #{brand},
 #{price},
 #{isFavorite},
 #{imageName},
 #{isSpring},
 #{isSummer},
 #{isAutumn},
 #{isWinter}
 )
</insert>


<!--３.データ削除-->
<!--#{id}：Javaの引数 Integer id で受け取った数字（「5」など）が、
自動的にここにスポッとあてはまります。MyBatisでJavaの変数をSQLに組み込みたいとき=#{変数名}-->
<delete id="deleteById">
 delete from item
 where id = #{id}
</delete>

<!--４.カテゴリー検索-->
<!--parameterType=Java側から「このデータをSQLで使ってね」と送り込むときのデータの型
=XMLの #{...} の中身に値を当てはめるために使う
引数が文字列（String）なら parameterType="String"、
クラス丸ごと渡すなら parameterType="Cloth" と書きます。-->
<!--resultType=SQLの select 文を実行した結果、Javaのどの型()クラス)にデータを詰め込んでほしいかを指定するもの
※データを消すだけの delete や、追加するだけの insert はデータを返さないため、resultType は不要-->
<select  id="findByCategory" parameterType="String" resultType="Cloth">
 select * from item
 where category = #{category}
</select>

</mapper>